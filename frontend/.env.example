# Base URL of the FastAPI backend. No trailing slash.
# Only variables prefixed with VITE_ are exposed to the browser bundle, so
# this file must never hold a secret. The Gemini API key stays in the
# backend .env and is never sent to the frontend.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Set to "true" to make POST /api/triage/batch return a local fixture instead
# of calling the backend. Lets the populated results view be built and
# reviewed without running a live Gemini batch. Anything else (or unset)
# means real API calls.
VITE_USE_MOCK_BATCH=false